# ==============================================================================
# Multi-stage Production Dockerfile: Laravel Queue Worker & Scheduler
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Vendor Dependencies Builder
# ------------------------------------------------------------------------------
FROM composer:2 AS composer-builder

WORKDIR /app

COPY backend/composer.json backend/composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-progress \
    --ignore-platform-reqs

# ------------------------------------------------------------------------------
# Stage 2: Production Worker Runtime
# ------------------------------------------------------------------------------
FROM php:8.3-cli-alpine AS production-worker

LABEL maintainer="WebIntoApp Engineering <ops@webintoapp.com>"
LABEL description="Hardened Supervisor-managed queue worker & scheduler for WebIntoApp"

# Install production system dependencies + supervisor + dcron
RUN apk add --no-cache \
    bash \
    curl \
    freetype \
    icu-libs \
    libjpeg-turbo \
    libpng \
    libzip \
    libsodium \
    oniguruma \
    supervisor \
    dcron

# Install build dependencies, compile PHP extensions, then purge build packages
RUN apk add --no-cache --virtual .build-deps \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    libsodium-dev \
    linux-headers \
    $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_mysql \
        sodium \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /tmp/pear

# Production CLI PHP configuration
RUN { \
    echo 'expose_php=Off'; \
    echo 'display_errors=Off'; \
    echo 'log_errors=On'; \
    echo 'error_log=/var/log/php-cli-error.log'; \
    echo 'memory_limit=512M'; \
    echo 'max_execution_time=0'; \
    echo 'date.timezone=UTC'; \
} > /usr/local/etc/php/conf.d/worker-security.ini

WORKDIR /var/www/backend

# Create non-root application user
RUN addgroup -g 1000 www && adduser -u 1000 -G www -D -s /bin/bash www

# Copy vendor packages from builder stage
COPY --from=composer-builder --chown=www:www /app/vendor /var/www/backend/vendor

# Copy application source code
COPY --chown=www:www backend /var/www/backend

# Ensure directories for storage, logs, and supervisor run/log dirs
RUN mkdir -p \
        /var/www/backend/storage/framework/cache/data \
        /var/www/backend/storage/framework/sessions \
        /var/www/backend/storage/framework/views \
        /var/www/backend/storage/logs \
        /var/www/backend/bootstrap/cache \
        /var/log/supervisor \
        /etc/supervisor/conf.d \
    && chown -R www:www /var/www/backend/storage /var/www/backend/bootstrap/cache \
    && chmod -R 775 /var/www/backend/storage /var/www/backend/bootstrap/cache \
    && chown -R www:www /var/log/supervisor

# Copy supervisor configuration
COPY infra/supervisor/supervisord.conf /etc/supervisor/supervisord.conf
COPY infra/supervisor/conf.d/ /etc/supervisor/conf.d/

# Copy crontab configuration for scheduler
COPY infra/cron/crontab /etc/crontabs/www
RUN chmod 0600 /etc/crontabs/www

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ps aux | grep -v grep | grep supervisord || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
