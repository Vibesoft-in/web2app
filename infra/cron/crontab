# ==============================================================================
# Linux Crontab Configuration: WebIntoApp Production Scheduler
# ==============================================================================
# Runs the Laravel scheduler every minute
* * * * * cd /var/www/backend && php artisan schedule:run >> /var/log/cron-laravel.log 2>&1

# Nightly database backup at 02:00 UTC
0 2 * * * /usr/local/bin/backup-database.sh >> /var/log/backup.log 2>&1

# Hourly health check & metric logging
0 * * * * /usr/local/bin/health-check.sh >> /var/log/health-cron.log 2>&1
