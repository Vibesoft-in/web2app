# ==============================================================================
# WebIntoApp Next.js Dashboard Production Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public API Gateway Endpoint
NEXT_PUBLIC_API_URL=https://api.webintoapp.com

# Razorpay Client-side Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID

# Frontend Sentry Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_FRONTEND_KEY@o000000.ingest.sentry.io/0000000
