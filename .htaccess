<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect /dashboard requests to /app
    RewriteRule ^dashboard/?$ /app [R=301,L]
    RewriteRule ^dashboard/(.*)$ /app/$1 [R=301,L]

    # Block direct web access to sensitive directories and dotfiles
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests) - [F,L]
    RewriteRule ^dashboard/(src|node_modules|public|package\.json|tsconfig\.json) - [F,L]
    RewriteRule ^(mobile|docs|infra|\.git|\.github) - [F,L]
    RewriteRule ^(\.env|\.gitignore|\.editorconfig) - [F,L]

    # Rewrite all web requests to Laravel public directory
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L,QSA]
</IfModule>

# Fallback: Deny directory listing
Options -Indexes
