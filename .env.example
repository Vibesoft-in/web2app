# ==============================================================================
# WebIntoApp Multi-Tenant SaaS Environment Variables (Template)
# DO NOT COMMIT REAL CREDENTIALS, SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Configuration
APP_NAME=WebIntoApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# Docker Infrastructure Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webintoapp
DB_USERNAME=webintoapp_user
DB_PASSWORD=secret_db_password
DB_ROOT_PASSWORD=secret_root_password

# Cache & Queues (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit in local/docker)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@webintoapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Multi-Tenant & Security
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,app.webintoapp.local
SESSION_DOMAIN=.webintoapp.local

# Razorpay (Phase 7 - Server-Side Only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Provisioning (Phase 6)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
