# ==============================================================================
# WebIntoApp Backend Production Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME="WebIntoApp"
APP_ENV=production
APP_KEY=base64:GENERATE_PRODUCTION_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.webintoapp.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Security & Sessions
BCRYPT_ROUNDS=12
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.webintoapp.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging & Monitoring
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# Sentry Production Error & Performance Monitoring
SENTRY_LARAVEL_DSN=https://YOUR_PUBLIC_KEY@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false

# Relational Database (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webintoapp_production
DB_USERNAME=webintoapp_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

# In-Memory Cache & Session Broker (Redis 7)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=webintoapp_cache_

# Asynchronous Queue Broker (Redis)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default

# Mailer (Production SMTP / SES)
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@webintoapp.com"
MAIL_FROM_NAME="WebIntoApp"

# Storage & Backups (AWS S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=webintoapp-production-storage
AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_S3_BUCKET=webintoapp-production-backups

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_LIVE_WEBHOOK_SECRET

# Push Notifications (Firebase Cloud Messaging HTTP v1)
FIREBASE_CREDENTIALS_PATH=/var/www/backend/storage/credentials/firebase-service-account.json

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_WHATSAPP_PHONE_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_SYSTEM_USER_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN

# Android Build Engine
FLUTTER_BIN=/opt/flutter/bin/flutter
BUILD_TIMEOUT_SECONDS=1800
BUILD_MAX_CONCURRENT_PER_TENANT=1
