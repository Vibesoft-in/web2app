includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    level: 5

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        - '#PHPDoc tag @use has invalid type#'
        - '#is not subtype of template type TFactory#'
        - '#Cannot cast non-empty-array#'

